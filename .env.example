# ==============================================================================
# PROMPTWARS / SKILLPATH AI - SUPABASE CONFIGURATION
# ==============================================================================
# Instructions:
# 1. Create a free project at https://supabase.com
# 2. Go to Project Settings -> API in your Supabase dashboard
# 3. Copy Project URL and Anon Public Key below
# 4. In Supabase SQL Editor, run the script from supabase/schema.sql
# ==============================================================================

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# Optional: Service Role key for backend administrative functions
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
